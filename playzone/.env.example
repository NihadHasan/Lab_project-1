# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PLAYZONE_SECRET_KEY=replace-with-a-random-secret-before-deployment
PLAYZONE_DATABASE=instance/playzone.sqlite3
PLAYZONE_SITE_URL=http://127.0.0.1:5000
# Optional comma-separated exact hostnames allowed for HTTPS game embeds.
PLAYZONE_EMBED_HOSTS=
# Set to 1 only when HTTPS is enabled.
PLAYZONE_COOKIE_SECURE=0